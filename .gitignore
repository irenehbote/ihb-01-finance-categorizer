# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environments and secrets: never commit keys
.venv/
venv/
.env
.env.*
!.env.example

# Notebooks: checkpoints only; outputs are stripped by pre-commit later
.ipynb_checkpoints/

# Personal financial data: this repo is public, so anything derived from my real
# bank CSVs (raw files, hand labels, the SQLite DB) must never be committed.
# Tests use synthetic CSVs in tests/fixtures/ instead.
data/raw/
data/*
!data/README.md
*.db
*.sqlite
*.sqlite3

# Model artifacts: too large for git, documented in README instead
models/
*.ckpt
*.safetensors

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
